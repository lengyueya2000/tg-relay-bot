name = "tg-relay-bot"
main = "src/index.js"
compatibility_date = "2024-09-01"

# 部署前先运行下面命令创建 KV,然后把返回的 id 填到下面:
#   npx wrangler kv namespace create RELAY_KV
[[kv_namespaces]]
binding = "RELAY_KV"
id = "在这里填入KV_NAMESPACE_ID"

[vars]
# 你的 Telegram 数字用户 ID(给 @userinfobot 发消息可查)
ADMIN_ID = "0"
# webhook 路径密钥,随便一串随机字符即可
WEBHOOK_SECRET = "change-me-to-a-random-string"

# BOT_TOKEN 不放这里,部署时用命令设置:
#   npx wrangler secret put BOT_TOKEN
